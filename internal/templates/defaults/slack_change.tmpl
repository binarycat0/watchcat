{{- /* Emoji for each change kind. */ -}}
{{define "emoji"}}
{{- if eq . "ci_failed"}}:x:
{{- else if eq . "ci_passed"}}:white_check_mark:
{{- else if eq . "conflict"}}:warning:
{{- else if eq . "conflict_resolved"}}:ok:
{{- else if eq . "changes_requested"}}:memo:
{{- else if eq . "approved"}}:tada:
{{- else if eq . "new_comments"}}:speech_balloon:
{{- else if eq . "pushed"}}:arrow_up:
{{- else if eq . "merged"}}:rocket:
{{- else if eq . "closed"}}:no_entry_sign:
{{- end}}
{{- end -}}

{{template "emoji" .Kind}} <{{.PR.URL}}|{{.PR.Ref}}> {{.PR.Title}}
{{.Message}}
{{- range .Checks}}
• {{if .URL}}<{{.URL}}|{{.Name}}>{{else}}{{.Name}}{{end}}
{{- end}}
