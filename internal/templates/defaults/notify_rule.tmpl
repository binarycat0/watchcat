{{- /* Emoji for each workflow rule. */ -}}
{{define "emoji"}}
{{- if eq . "merge"}}🚀
{{- else if eq . "review_threads"}}💬
{{- else if eq . "ci_failed"}}❌
{{- else if eq . "needs_review"}}👀
{{- end}}
{{- end -}}

{{template "emoji" .Rule}} {{link .PR.URL .PR.Ref}} {{.PR.Title}}
{{if eq .Rule "merge"}}Ready to merge: CI green, approved, no open conversations.
{{- else if eq .Rule "review_threads"}}Approved and green, but {{.Unresolved}} conversation(s) are unresolved.
{{- else if eq .Rule "ci_failed"}}CI failed: {{names .FailedChecks}}.
{{- else if eq .Rule "needs_review"}}CI is green and the PR needs a review.
{{- end}}
{{if .DryRun}}Dry run, nothing changed. Would {{.Action}}.{{else}}Next: {{.Action}}.{{end}}
